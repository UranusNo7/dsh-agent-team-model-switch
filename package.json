{
  "name": "dsh-team-model-switcher-2",
  "version": "0.1.1",
  "private": true,
  "description": "Switch the model and reasoning effort of a live Agent Teams teammate: a Lead-facing tool plus a Web header panel",
  "type": "module",
  "license": "MIT",
  "main": "./lib/entry.js",
  "exports": {
    ".": {
      "default": "./lib/entry.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-experimental-agent-team": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "agent-teams",
    "cordis"
  ]
}
